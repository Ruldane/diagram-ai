# Copy to .env.local and fill in what you need. Everything is optional:
# without any of these the app runs on one machine, storing diagrams as JSON files in ./data.

# --- PostgreSQL storage, and (separately, opt-in) accounts and sharing ---------------------------
# Start the bundled database with `npm run db:up`, then:
# DATABASE_URL=postgres://diagram_ai:diagram_ai@127.0.0.1:5435/diagram_ai
# Host port the bundled database listens on (docker-compose.yml); change it together with the URL above.
# DIAGRAM_AI_PG_PORT=5435
# Set to 0 to apply migrations yourself with `npm run db:migrate` instead of on first use.
# DIAGRAM_AI_AUTO_MIGRATE=1
# Read by `npm run test:db`; the tests work in a throw-away schema. See docs/database.md.
# DATABASE_URL_TEST=postgres://diagram_ai:diagram_ai@127.0.0.1:5435/diagram_ai

# DATABASE_URL alone only changes where diagrams are stored: no login, MCP needs no token, the Ask panel
# and the Claude Code bridge work. Accounts, roles, sharing and personal access tokens are opt-in and need
# both: DIAGRAM_AI_AUTH=on and DATABASE_URL (docs/auth.md). The first account becomes the administrator
# and owner of every diagram that had no owner.
# DIAGRAM_AI_AUTH=on
# Who may create an account after the first one (the first always may, and becomes the administrator):
#   invite (default) only with a share link, open anyone, closed an administrator adds people.
# DIAGRAM_AI_SIGNUP=invite
# Set to 1 when a reverse proxy you control terminates TLS and sets X-Forwarded-For / X-Forwarded-Proto.
# DIAGRAM_AI_TRUST_PROXY=0
# Personal access token an agent sends to /api/mcp when accounts are on (create one in Account settings).
# DIAGRAM_AI_TOKEN=dai_...

# --- In-app assistant (the "Ask" panel) -----------------------------------------------------------
# Two engines; the panel uses Claude Code when it is installed and signed in, else the API key.
# Claude Code (your own `claude` login and plan, no key). Only in single-user mode, only when the app
# is opened at http://localhost:<port> on the same computer. Read "Legal and policy" in docs/assistant.md.
# DIAGRAM_AI_LOCAL_AGENTS=off        # never start local CLIs from the Ask panel
# DIAGRAM_AI_CLAUDE_PATH=            # full path of the claude executable if it is not found by itself
# DIAGRAM_AI_CLAUDE_MODEL=           # a model alias or name for Claude Code runs, e.g. sonnet or haiku
# DIAGRAM_AI_BRIDGE_WORKDIR=         # folder the CLI runs in when none is chosen (default <data dir>/bridge/workdir)
# DIAGRAM_AI_BRIDGE_TIMEOUT_MS=600000
# Claude API: billed to your Anthropic API account, separately from a Claude Code plan. A key here
# is never handed to the Claude Code CLI.
# ANTHROPIC_API_KEY=sk-ant-...
# DIAGRAM_AI_MODEL=claude-sonnet-5-5

# --- Misc ----------------------------------------------------------------------------------------
# Where JSON diagrams, checkpoints and agent exports are stored in file mode (default ./data).
# DIAGRAM_DATA_DIR=./data
